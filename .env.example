# ==========================================
# IELTS AI Coach — Environment Configuration
# ==========================================

# Relational Database (Defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./ielts_coach.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ielts_coach

# Authentication & Security
JWT_SECRET=ielts_ai_coach_super_secure_jwt_secret_key_2026

# Large Language Model Providers (Optional: built-in intelligent NLP heuristic engine runs offline without keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_URL=http://localhost:11434

# Speech AI & Voice Providers (Optional: browser Web Speech API runs with zero credentials)
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
